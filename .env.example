# Buty.app — переменные окружения (скелет, собран из всех 8 брифов)

# --- База данных (часть 2) ---
DATABASE_URL="postgresql://user:password@localhost:5432/buty?schema=public"
# Прямое подключение для миграций (Supabase: порт 5432); локально — то же, что DATABASE_URL
DIRECT_URL="postgresql://user:password@localhost:5432/buty?schema=public"

# --- Аутентификация NextAuth (часть 5) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Email magic-link: dev — MockEmailProvider (ссылка в консоль), прод — Resend
EMAIL_FROM="Buty.app <noreply@buty.app>"
RESEND_API_KEY=""

# --- OCR: распознавание фото состава (Google Cloud Vision) ---
# Пусто — mock (кнопка «Загрузить фото» показывает «скоро»). Ключ: Google Cloud → APIs & Services → Credentials,
# ограничить ключ только Cloud Vision API. Лимит: 20 фото в час с одного IP (lib/ocr/rate-limit.ts).
GOOGLE_VISION_API_KEY=""
# Необязательно: адрес переходника в Европе (infra/ocr-proxy). При переходнике в GOOGLE_VISION_API_KEY
# кладётся не ключ Google, а PROXY_SECRET функции. По умолчанию https://vision.googleapis.com/v1/images:annotate
GOOGLE_VISION_ENDPOINT=""

# --- ИИ-резюме состава (Gemini) ---
# Пусто — блок «Коротко о составе» не показывается, разбор работает как раньше.
# Через переходник (infra/ocr-proxy): GEMINI_ENDPOINT — адрес функции, GEMINI_API_KEY — её PROXY_SECRET.
# Без GEMINI_ENDPOINT запрос идёт напрямую в Google с настоящим ключом (только для разработки вне РФ).
GEMINI_API_KEY=""
GEMINI_ENDPOINT=""
# Необязательно: модель (по умолчанию gemini-3.5-flash-lite) и уровень рассуждений (по умолчанию low; "" — как у модели)
GEMINI_MODEL=""
GEMINI_THINKING_LEVEL="low"
# Необязательно: не больше N новых обращений к ИИ в сутки (по умолчанию 2000; ответы из кэша не считаются)
AI_SUMMARY_DAILY_LIMIT=""

# --- Платежи (часть 7) ---
# mock — MockPaymentProvider по умолчанию; реальный провайдер — ЮKassa
PAYMENTS_PROVIDER=mock
YUKASSA_SHOP_ID=""
YUKASSA_SECRET_KEY=""

# --- Cron-напоминания (часть 6) ---
# Проверяется заголовком x-cron-secret в /api/cron/reminders
CRON_SECRET=""

# --- Мобильное приложение (iOS, папка mobile/) ---
# Демо-вход для проверки в App Store: Apple входит без доступа к почте.
# Оба значения обязательны, код — ровно 6 цифр. После одобрения можно оставить или очистить.
APP_REVIEW_EMAIL=""
APP_REVIEW_CODE=""
# Необязательно: токен Expo для «Enhanced push security» (expo.dev → Access tokens).
EXPO_ACCESS_TOKEN=""

# --- Админка (часть 8) ---
# Список email через запятую — доступ к /admin
ADMIN_EMAILS=""

# --- Продакшен-деплой (часть 9, только .env на сервере) ---
# Домен для Caddy (HTTPS, редирект www) и пароль Postgres
DOMAIN="example.com"
POSTGRES_PASSWORD=""

# SEO: канонический домен (sitemap, canonical, микроразметка) и подтверждение прав в вебмастерах
NEXT_PUBLIC_SITE_URL="https://buty.app"
# YANDEX_VERIFICATION="95c6e4ac045fc04e"  # по умолчанию уже в коде
GOOGLE_SITE_VERIFICATION=""
# Яндекс Метрика: по умолчанию в production — счётчик 113224497; задайте номер, чтобы переопределить, или "" — чтобы выключить
# NEXT_PUBLIC_YM_ID="113224497"

# Google tag (GA4): по умолчанию в production — G-BDBSNMGYRS; задайте ID, чтобы переопределить, или "" — чтобы выключить. Инициализация только после согласия на cookie (consent "all")
# NEXT_PUBLIC_GA_ID="G-BDBSNMGYRS"

# Mixpanel (analytics): project token; пустое значение выключает трекинг. Инициализация только после согласия на cookie (consent "all")
# NEXT_PUBLIC_MIXPANEL_TOKEN=""
# Только если проект Mixpanel создан с хранением данных в ЕС (EU Data Residency): https://api-eu.mixpanel.com
# NEXT_PUBLIC_MIXPANEL_API_HOST=""
# Session Replay: доля сессий с записью, % (по умолчанию 100; 0 — выключить)
# NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT="100"

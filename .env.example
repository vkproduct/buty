# Buty.ru — переменные окружения (скелет, собран из всех 8 брифов)

# --- База данных (часть 2) ---
DATABASE_URL="postgresql://user:password@localhost:5432/buty?schema=public"

# --- Аутентификация NextAuth (часть 5) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Email magic-link: dev — MockEmailProvider (ссылка в консоль), прод — Resend
EMAIL_FROM="Buty.ru <noreply@buty.ru>"
RESEND_API_KEY=""

# --- OCR (часть 3) ---
# true — MockOcrProvider по умолчанию; реальный провайдер подключается в проде
MOCK_OCR=true
YANDEX_VISION_API_KEY=""
YANDEX_VISION_FOLDER_ID=""

# --- Платежи (часть 7) ---
# mock — MockPaymentProvider по умолчанию; реальный провайдер — ЮKassa
PAYMENTS_PROVIDER=mock
YUKASSA_SHOP_ID=""
YUKASSA_SECRET_KEY=""

# --- Cron-напоминания (часть 6) ---
# Проверяется заголовком x-cron-secret в /api/cron/reminders
CRON_SECRET=""

# --- Админка (часть 8) ---
# Список email через запятую — доступ к /admin
ADMIN_EMAILS=""

# --- Продакшен-деплой (часть 9, только .env на сервере) ---
# Домен для Caddy (HTTPS, редирект www) и пароль Postgres
DOMAIN="example.com"
POSTGRES_PASSWORD=""

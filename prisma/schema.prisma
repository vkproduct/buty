// Buty.ru — база ингредиентов (часть 2/8)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EvidenceLevel {
  STRONG // множество RCT / мета-анализы
  MODERATE // клинические исследования, но ограниченные
  LIMITED // in vitro / единичные исследования
  ANECDOTAL // традиционное применение, без качественных данных
}

model Ingredient {
  id           String            @id @default(cuid())
  inciName     String            @unique // каноническое INCI-имя, UPPERCASE
  slug         String            @unique
  displayName  String // русское название для UI
  category     String // категория: active, uv-filter, humectant и т.д.
  function     String // функция в составе
  evidenceLevel EvidenceLevel
  typicalConc  String? // типичная рабочая концентрация, напр. "2–5%"
  description  String
  safetyNotes  String?

  synonyms     Synonym[]
  conflictsFrom IngredientConflict[] @relation("ConflictFrom")
  conflictsTo   IngredientConflict[] @relation("ConflictTo")
  products      ProductIngredient[]

  @@index([category])
}

model Synonym {
  id           String     @id @default(cuid())
  ingredientId String
  alias        String // альтернативное написание (лат./рус.)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, alias])
  @@index([alias])
}

// Самоссылка many-to-many: конфликт двух активов в одном уходе
model IngredientConflict {
  id            String     @id @default(cuid())
  ingredientAId String
  ingredientBId String
  severity      String // "high" | "medium" | "low"
  reason        String // механизм конфликта
  ingredientA   Ingredient @relation("ConflictFrom", fields: [ingredientAId], references: [id], onDelete: Cascade)
  ingredientB   Ingredient @relation("ConflictTo", fields: [ingredientBId], references: [id], onDelete: Cascade)

  @@unique([ingredientAId, ingredientBId])
}

model Product {
  id          String              @id @default(cuid())
  brand       String
  name        String
  slug        String              @unique
  category    String
  sourceUrl   String?
  partnerUrl  String? // партнёрская ссылка (заполняется в части 4, используется в части 7)
  ingredients  ProductIngredient[]
  shelfItems   ShelfItem[]
  partnerClicks PartnerClick[]

  @@index([brand])
}

// Join-таблица Product → Ingredient с позицией в INCI-списке (порядок = убывание концентрации)
model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  position     Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@unique([productId, position])
}

// Сообщение пользователя о нераспознанном токене состава (часть 3)
model Feedback {
  id        String   @id @default(cuid())
  email     String? // опционально, для ответа пользователю
  rawToken  String // нераспознанный токен как в исходном тексте
  createdAt DateTime @default(now())
}

// --- Часть 5: аутентификация и «Моя полка» ---

// Модели NextAuth (PrismaAdapter)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  shelfItems    ShelfItem[]
  skinProfile   SkinProfile?
  reactions     SkinReaction[]
  reminders     Reminder[]
  subscription  Subscription?
  partnerClicks PartnerClick[]
}

enum ShelfStatus {
  using // использую
  finished // закончила
  reacted // была реакция
}

enum SkinType {
  dry
  oily
  combination
  normal
  sensitive
}

model ShelfItem {
  id         String      @id @default(cuid())
  userId     String
  productId  String? // ссылка на Product из базы
  customName String? // «своё средство» — название вручную
  customInci String? // разобранные INCI-токены «своего средства» (JSON-массив)
  status     ShelfStatus @default(using)
  photoUrl   String?
  addedAt    DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  reactions  SkinReaction[]
  reminders  Reminder[]

  @@index([userId])
}

model SkinProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  skinType  SkinType
  concerns  String[] // проблемы кожи: акне, пигментация и т.д.
  allergies String[] // аллергии/непереносимости (ингредиенты)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Часть 6: логика «Моей полки» ---

// История реакций кожи на средство с полки
model SkinReaction {
  id                   String    @id @default(cuid())
  userId               String
  shelfItemId          String
  type                 String // redness | itching | burning | breakouts | dryness | other
  note                 String?
  photoUrl             String? // опциональное фото реакции
  occurredAt           DateTime  @default(now()) // дата реакции (указывает пользователь)
  createdAt            DateTime  @default(now())
  suspectIngredientIds String    @default("[]") // JSON-массив id подозреваемых ингредиентов средства
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelfItem            ShelfItem @relation(fields: [shelfItemId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

enum ReminderType {
  introduce // напомнить о введении средства (28 дней)
  restock // напомнить о покупке (90 дней)
}

model Reminder {
  id          String           @id @default(cuid())
  userId      String
  shelfItemId String
  type        ReminderType
  payload     String? // JSON с контекстом (название средства и т.п.)
  nextRunAt   DateTime
  doneAt      DateTime? // когда отработано (null — ждёт)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelfItem   ShelfItem        @relation(fields: [shelfItemId], references: [id], onDelete: Cascade)
  logs        NotificationLog[]

  @@index([nextRunAt, doneAt])
  @@index([userId])
}

// Лог отправленных уведомлений (MockNotifier пишет сюда)
model NotificationLog {
  id         String   @id @default(cuid())
  reminderId String
  channel    String // "mock" | будущие: email, telegram
  message    String
  createdAt  DateTime @default(now())
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
}

// --- Часть 7: монетизация ---

enum Plan {
  free
  pro
}

// Подписка пользователя (одна запись на пользователя)
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             Plan      @default(free)
  status           String    @default("active") // active | canceled | past_due
  currentPeriodEnd DateTime? // null для free
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Клик по партнёрской ссылке «Где купить» (для будущей аналитики брендов)
model PartnerClick {
  id        String   @id @default(cuid())
  userId    String? // null — незалогиненный пользователь
  productId String
  source    String // откуда клик: product_page, shelf и т.д.
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}

// Заявка бренда со страницы /for-brands
model BrandLead {
  id        String   @id @default(cuid())
  brandName String
  contact   String // контактное лицо
  email     String
  message   String
  createdAt DateTime @default(now())
}
